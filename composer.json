{
    "name": "elig45/bagisto-helloasso",
    "description": "HelloAsso checkout payment method for Bagisto 2.4",
    "type": "library",
    "license": "AGPL-3.0-only",
    "require": {
        "php": "^8.3 || ^8.4",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "Elig45\\BagistoHelloAsso\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Elig45\\BagistoHelloAsso\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "check-translations": "php scripts/check-translations.php"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Elig45\\BagistoHelloAsso\\Providers\\HelloAssoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
